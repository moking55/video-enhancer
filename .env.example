# Copy to web/.env.local and fill in. NEVER commit real values.
# Only NEXT_PUBLIC_* vars are exposed to the browser; everything else is server-only.

# Supabase dev project ref (dev project ref, not secret; used only by pnpm db:types)
SUPABASE_PROJECT_ID=

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key (public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret (service role) key -- SERVER-ONLY, never expose to browser/Colab
SUPABASE_SECRET_KEY=

# Emails allowed to sign in (max ~5), comma-separated; trimmed, case-insensitive,
# empty entries ignored. Unset/empty = server misconfigured (500), never allow-all.
# SERVER-ONLY
ALLOWED_EMAILS=
# Operators (the owner): the only users who can issue worker tokens and use the
# Colab worker. Same format. An operator not listed in ALLOWED_EMAILS is still
# treated as allowed. SERVER-ONLY
OPERATOR_EMAILS=

# Cloudflare R2 (S3-compatible) endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com -- SERVER-ONLY
STORAGE_ENDPOINT=
# S3 region for R2 must be `auto` -- SERVER-ONLY
STORAGE_REGION=auto
# R2 bucket name: video-enhancer -- SERVER-ONLY
STORAGE_BUCKET=video-enhancer
# R2 API token Access Key ID (scoped to the bucket, Object Read & Write) -- SERVER-ONLY
STORAGE_ACCESS_KEY_ID=
# R2 API token Secret Access Key -- SERVER-ONLY, never send to Colab
STORAGE_SECRET_ACCESS_KEY=
